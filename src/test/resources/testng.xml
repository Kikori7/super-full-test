<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  购物车 UI 自动化测试套件

  Listener 顺序（重要！）：
    RetryConfigListener → ConditionalRetryTransformer → FailureListener → ReportEmailListener

  命令行参数覆盖：
    mvn test -Dtest.retry.enabled=false
    mvn test -Dtest.retry.max=5
-->
<suite name="ShoppingCartSuite" verbose="1">

    <parameter name="retryEnabled" value="true"/>
    <parameter name="retryMax" value="2"/>
    <parameter name="retryDelayMs" value="0"/>

    <listeners>
        <listener class-name="org.example.base.retry.RetryConfigListener"/>
        <listener class-name="org.example.base.retry.ConditionalRetryTransformer"/>
        <listener class-name="org.example.base.listener.FailureListener"/>
        <listener class-name="org.example.base.listener.ReportEmailListener"/>
    </listeners>

    <test name="CartButtonDisplay">
        <classes>
            <class name="org.example.CartButtonDisplayTest"/>
        </classes>
    </test>

</suite>
